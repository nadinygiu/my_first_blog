<div id="<%= dom_id post %>" class="w-full h-full  max-w-sm py-4 ">
    <div class="bg-rose-100 w-full rounded overflow-hidden shadow-lg">
  
 <% if post.image.attached? %>
<%= image_tag post.image, class: "w-full object-cover", alt: "Imagem do post" %>
<% else %>
  <img class="w-full" src="" alt="">
<% end %>
  <div class="px-6 py-4">

  
    <p class="text-gray-700 text-base">
      <%= post.comment %>
    </p>
  </div>
  <div class="px-6 pt-4 pb-2">


  <% if post.tags.present? %>
    <% post.tags.split(',').each do |tag| %>
      <span class="inline-block bg-gray-300 rounded-full px-3 py-1 text-sm font-semibold text-gray-700 mr-2 mb-2">
        # <%= tag.strip %>
      </span>
    <% end %>
  <% end %>
</div>


<div class="flex justify-center items-center gap-1 mt-auto py-2">
      <div class="ms-8 inline-block mx-1 bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-full">
        <%= link_to "Show", post%>
      </div>
      <div class="inline-block mx-1   bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-full">
        <%= link_to "Edit", post%>
      </div>
      <div class="inline-block mx-1 bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded-full">
        <%= button_to "Destroy", post, method: :delete, data: { turbo_confirm: "Are you sure?" }%>
      </div>
    
 </div>
</div>
