
<% content_for :title, "Posts" %>

<div class="w-full">
  <% if notice.present? %>
    <%= notice %>
  <% end %>

  <div class="flex justify-between items-center mb-5">
    <h1 class="font-bold text-4xl">Pag Inicial</h1>
    <%= link_to "New post", new_post_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

<div id="posts" class="flex flex-wrap justify-center gap-6">
        <% if @posts.any? %>
      <% @posts.each do |post| %>
        <%= render post %>
      <% end %>
    <% else %>
      <p class="text-center my-10">No posts found.</p>
    <% end %>
  </div>
</div> 